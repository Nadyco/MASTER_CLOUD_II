@Metadata.layer: #INDUSTRY
@UI:{ headerInfo:{ typeName: 'Customer',
                   typeNamePlural: 'Customers',
                   title:{ type: #STANDARD,
                           value: 'CustomerId' }
                   },

       presentationVariant: [{ sortOrder: [{by: 'CustomerId',
                                            direction: #ASC }],
                               visualizations: [{ type: #AS_LINEITEM  }] }]

    }
annotate entity Z_C_CUSTOMER_TRAVEL_NC with

{
  @UI.lineItem: [{
      position: 10,
      importance:#HIGH,
      emphasized: true
  }]
  
  //filtros 
  @UI.selectionField: [{ position: 10 }]
  
  @UI.textArrangement: #TEXT_FIRST
  
  //ayuda de busqueda
  @Consumption.valueHelpDefinition: [{ entity: {
                                           name: '/DMO/I_Customer_StdVH',
                                           element: 'CustomerID'
                                       },
                                       useForValidation: true    }]
  CustomerId;

  @UI.lineItem: [{
    position:20,
    importance:#HIGH,
    label: 'Customer Name',
    emphasized: true
  }]
  Lastname;

  @UI.lineItem: [{
    position:30,
    importance:#HIGH,
    label: 'Customer Country',
    emphasized: true
  }]
  Countryname;

  @UI.lineItem: [{
  position:40,
  importance:#HIGH,
  emphasized: true
  }]
  Description;
}