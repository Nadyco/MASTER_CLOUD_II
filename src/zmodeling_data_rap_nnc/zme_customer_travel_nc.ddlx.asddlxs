@Metadata.layer: #INDUSTRY
@UI:{ headerInfo:{ typeName: 'Customer',
                   typeNamePlural: 'Customers',
                   title:{ type: #STANDARD,
                           value: 'CustomerId' }
                   },

       presentationVariant: [{ sortOrder: [{by: 'CustomerId',
                                            direction: #ASC }],
                               visualizations: [{ type: #AS_LINEITEM  }] }]

    }
annotate entity Z_C_CUSTOMER_TRAVEL_NC with

{

 @UI.facet: [{

     id: 'CustomerDetails',
     purpose: #STANDARD,
     position: 10,
     label: 'Customer Details',
     type: #IDENTIFICATION_REFERENCE 

 }]
 
  @UI.lineItem: [
                 { position: 10, importance:#HIGH, emphasized: true }, 
                 { type: #FOR_ACTION, dataAction: 'AcceptCustomer', label : 'Accept Customer', position: 20 },
                 { type: #FOR_ACTION, dataAction: 'RejectCustomer', label : 'Reject Customer', position: 30 }           
                ]
  
  //filtros 
  @UI.selectionField: [{ position: 10 }]
  
  @UI.textArrangement: #TEXT_FIRST
  
  //ayuda de busqueda
  @Consumption.valueHelpDefinition: [{ entity: {
                                           name: '/DMO/I_Customer_StdVH',
                                           element: 'CustomerID'
                                       },
                                       useForValidation: true    }]
 // Se arega el detalle al seleccionar la pestaña facet
  @UI.identification: [{ position:10 },
  { type: #FOR_ACTION, dataAction: 'AcceptCustomer', label : 'Accept Customer', position: 10 },
  { type: #FOR_ACTION, dataAction: 'RejectCustomer', label : 'Reject Customer', position: 20 }
  ]
  CustomerId;
  
  
  

  @UI.lineItem: [{
    position:20,
    importance:#HIGH,
    label: 'Customer Name',
    emphasized: true
  }]
  
  @UI.identification: [{ position:20 }]
  Lastname;

  @UI.lineItem: [{
    position:30,
    importance:#HIGH,
    label: 'Customer Country',
    emphasized: true
  }]
  
  @UI.identification: [{ position:30 }]
  Countryname;

  @UI.lineItem: [{
  position:40,
  importance:#HIGH,
  emphasized: true
  }]
      
      
  @UI.identification: [{ position:40 }]
  @UI.hidden: true
  Description;
  
  @UI.hidden: true
  CustomerUuid;
  
  @UI.hidden: true
  LastChangedAt;
  @UI.hidden: true
  LocalLastChangedAt;
  
};