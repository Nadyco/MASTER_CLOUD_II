@Metadata.layer: #CORE
@UI:{ headerInfo: {
          typeName: 'History',
          typeNamePlural: 'Historys',
          title: { type: #STANDARD,
              value: 'HisId'
            } },

      presentationVariant: [{ sortOrder: [{by: 'HisId',
                                            direction: #ASC }],
                               visualizations: [{ type: #AS_LINEITEM  }] }]
}

@UI.createHidden: true
annotate entity ZC_INCT_H_NC with
{
  @UI.hidden: true
  HisUuid;
  @UI.hidden: true
  IncUuid;

  @UI.facet: [{

     id: 'HistoryDetails',
     purpose: #STANDARD,
     position: 10,
     label: 'History Details',
     type: #IDENTIFICATION_REFERENCE
  }]
  
  @UI.lineItem: [{ position: 10, importance:#HIGH, emphasized: true }]
  @UI.identification: [{ position:10 }]
  HisId;
  @UI.lineItem: [{ position: 20, importance:#LOW, emphasized: true }]
  @UI.identification: [{ position:20 }]
  PreviousStatus;
  @UI.lineItem: [{ position: 30, importance:#LOW, emphasized: true }]
  @UI.identification: [{ position:30 }]
  NewStatus;
  @UI.lineItem: [{ position: 40, importance:#LOW, emphasized: true }]
  @UI.identification: [{ position:40 }]
  Text;

  @UI.hidden: true
  LocalCreatedBy;
  @UI.hidden: true
  LocalCreatedAt;
  @UI.hidden: true
  LocalLastChangedBy;
  @UI.hidden: true
  LocalLastChangedAt;
  @UI.hidden: true
  LastChangedAt;
  /* Associations */
  //      _incident;

}