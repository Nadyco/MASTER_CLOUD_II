@Metadata.layer: #CORE
@UI:{ headerInfo: {
          typeName: 'History',
          typeNamePlural: 'Historys',
          title: { type: #STANDARD,
              value: 'HisId'
            } },

      presentationVariant: [{ sortOrder: [{by: 'HisId',
                                            direction: #ASC }],
                               visualizations: [{ type: #AS_LINEITEM  }] }]
}

@UI.createHidden: true
annotate entity ZC_INCT_H_NC with
{
  @UI.hidden: true
  @UI.lineItem: [{ position: 10 }]
  HisUuid;

  @UI.hidden: true
  @UI.lineItem: [{ position: 20 }]
  IncUuid;

  @UI.facet: [{

     id: 'HistoryDetails',
     purpose: #STANDARD,
     position: 30,
     label: 'History Details',
     type: #IDENTIFICATION_REFERENCE
  }]

  @UI.lineItem: [{ position: 30, importance:#HIGH, emphasized: true }]
  @UI.identification: [{ position:30 }]
  HisId;
  
  @UI.lineItem: [{ position: 40, importance:#LOW, emphasized: true }]
  @UI.identification: [{ position:40 }]
  PreviousStatus;
  
  @UI.lineItem: [{ position: 50, importance:#LOW, emphasized: true }]
  @UI.identification: [{ position:50 }]
  NewStatus;
  
  @UI.lineItem: [{ position: 60, importance:#LOW, emphasized: true }]
  @UI.identification: [{ position:60 }]
  Text;

  @UI.hidden: true
  LocalCreatedBy;
  
  @UI.hidden: true
  LocalCreatedAt;
  
  @UI.hidden: true
  LocalLastChangedBy;
  
  @UI.hidden: true
  LocalLastChangedAt;
  
  @UI.hidden: true
  LastChangedAt;
  
  /* Associations */
  @UI.hidden: true
  _incident;

}