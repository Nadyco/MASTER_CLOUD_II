@Metadata.layer: #CORE
@UI:{ headerInfo: {
          typeName: 'Incident',
          typeNamePlural: 'Incidents',
          title: { type: #STANDARD,
              value: 'IncidentId'
            } },

      presentationVariant: [{ sortOrder: [{by: 'IncidentId',
                                            direction: #ASC }],
                               visualizations: [{ type: #AS_LINEITEM  }] }]
                               
     
}

          
          
annotate entity ZC_INCT_NC with
{

  @UI.hidden: true
  @UI.facet: [{

     id: 'IncidentDetails',
     purpose: #STANDARD,
     position: 10,
     label: 'Incident Details',
     type: #IDENTIFICATION_REFERENCE
  },
  { id: 'History',
          purpose: #STANDARD,
          position: 20,
          label: 'History',
          type: #LINEITEM_REFERENCE,
          targetElement: '_History' }
          ]

  @UI.lineItem: [{type: #FOR_ACTION, dataAction: 'ChangeStatus', label : 'Change Status', position: 10  }]
  IncUuid;


  @UI.lineItem: [{ position: 20, importance:#HIGH, emphasized: true }]
  @UI.selectionField: [{ position: 20 }]
  @UI.identification: [{ position:20 },
                       {type: #FOR_ACTION, dataAction: 'ChangeStatus', label : 'Change Status', position: 20}
                      ]  
  IncidentId;

  @UI.lineItem: [{ position: 30, importance:#HIGH, emphasized: true }]
  @UI.identification: [{ position:30 }]
  Title;

  @UI.lineItem: [{ position: 40, importance:#HIGH, emphasized: true }]
  @UI.selectionField: [{ position: 40 }]
  @UI.identification: [{ position:40 }]
  Description;

  @UI.lineItem: [{ position: 50, importance:#HIGH, emphasized: true }]
  @UI.identification: [{ position:50 }]
  //filtros
  @UI.selectionField: [{ position: 50 }]
  @UI.textArrangement: #TEXT_FIRST
  @Consumption.valueHelpDefinition: [{ entity: { name: 'ZI_STATUS_VH_NC',
                                                 element: 'StatusCode'
                                                },

                                        useForValidation: true
                                   }]

  Status;

  @UI.lineItem: [{ position: 60, importance:#HIGH, emphasized: true }]
  @UI.identification: [{ position:60 }]
  @UI.selectionField: [{ position: 60 }]
  @Consumption.valueHelpDefinition: [{ entity: { name: 'ZI_PRIORITY_VH_NC',
                                                 element: 'PriorityCode'
                                                },

                                        useForValidation: true
                                   }]
  Priority;

  @UI.lineItem: [{ position: 70, importance:#HIGH, emphasized: true }]
  @UI.selectionField: [{ position:70 }]
  @UI.identification: [{ position:70 }]
  CreatedDate;
  
  @UI.lineItem: [{ position: 80, importance:#HIGH, emphasized: true }]
  @UI.identification: [{ position:80 }]
  @UI.selectionField: [{ position: 80 }]
  ChangedDate;


  @UI.hidden: true
  LocalCreatedBy;

  @UI.hidden: true
  LocalCreatedAt;

  @UI.hidden: true
  locallastchangedby;

  @UI.hidden: true
  locallastchangedat;

  @UI.hidden: true
  lastchangedat;

///* Associations */
  @UI.hidden: true
  _History;

}