projection;
strict ( 2 );
use draft;

define behavior for ZC_INCT_NC alias Incidents
{
  use create;
  use update;
  use delete;

  use action ChangeStatus;

  use action Resume;
  use action Edit;
  use action Activate;
  use action Discard;
  use action Prepare;

  use association _History { create; with draft; }
}

define behavior for ZC_INCT_H_NC alias History
{
//  use update;
//  use delete;

  use association _incident { with draft; }
}